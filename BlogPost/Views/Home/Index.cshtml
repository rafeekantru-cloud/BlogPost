@{
    ViewData["Title"] = "Clients";
}

<h2>Clients</h2>

<p>This is the Client List Page.</p>

<div class="row">

    <div class="col-md-6">

        <label class="form-label">Client</label>

        <div class="input-group">

            <input type="hidden"
                   id="ClientId"
                    />

            <input type="text"
                   id="ClientName"
                   
                   class="form-control"
                   readonly />

            <button class="btn btn-primary"
                    type="button"
                    id="btnSearchClient">
                🔍
                <i class="bi bi-search"></i>

            </button>

        </div>

    </div>

</div>
<div class="modal fade"
     id="clientModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Search Client
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="text"
                       class="form-control mb-3"
                       id="txtSearch"
                       placeholder="Search client..." />

                <table class="table table-hover">

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Name</th>

                            <th>Select</th>

                        </tr>

                    </thead>

                    <tbody>

                        <tr>

                            <td>1</td>

                            <td>John Smith</td>

                            <td>

                                <button class="btn btn-success btnSelect"
                                        data-id="1"
                                        data-name="John Smith">

                                    Select

                                </button>

                            </td>

                        </tr>

                        <tr>

                            <td>2</td>

                            <td>Mary Jones</td>

                            <td>

                                <button class="btn btn-success btnSelect"
                                        data-id="2"
                                        data-name="Mary Jones">

                                    Select

                                </button>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>




